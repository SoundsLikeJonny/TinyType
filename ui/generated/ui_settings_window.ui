           </item>
           <item row="3" column="0">
            <widget class="QLabel" name="label_cycleOptionDown">
             <property name="toolTip">
              <string>Press this key to decrease the value of the current mode option — e.g. 50→25 words, 60s→30s, or medium→short quotes. Only works when no test is running.</string>
             </property>
             <property name="text">
              <string>Cycle Test Variation Down (within mode):</string>
